# Google track (AI Builder Cup): key from aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# NVIDIA track (Nebius x NVIDIA hackathon): a Nebius Token Factory key from tokenfactory.nebius.com.
# Leave the rest empty to use the defaults: Token Factory, Nemotron 3 Super for the interview,
# Nemotron 3 Ultra for drawing the screens.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
NVIDIA_HEAVY_MODEL=
NVIDIA_DAILY_CALLS=

# Optional: Scout Bee web research. Free key from app.tavily.com.
TAVILY_API_KEY=

# Public Firebase web config (JSON on one line). Turns on "Sign in with Google". Not a secret.
FIREBASE_WEB_CONFIG=
